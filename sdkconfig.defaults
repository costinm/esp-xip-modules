# Same baseline as esp-wifi-loader's Main images (docs/app-integration.md there):
# the loader's Stage2 boots us in DIO or QIO; the driver must stay DIO.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# Lets a module (or the loader) ask for the loader on the next boot; reserve the RTC area like the loader does.
CONFIG_BOOTLOADER_RESERVE_RTC_MEM=y
CONFIG_BOOTLOADER_RESERVE_RTC_SIZE=0x10
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC=y
CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE=0x20
# C runtime diagnostics: keep host warnings; SDK drivers are quiet in CMakeLists.txt.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_FREERTOS_HZ=1000

# Allocation limit, not reserved RAM: accommodates the optional external flash module.
CONFIG_XIP_MEM_QUOTA=0

# Keep the C sample small; the Rust runtime has its own WPA3-enabled defaults.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n

# Preserve checks, without source paths/expressions or verbose SDK check messages.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=y
CONFIG_LWIP_ESP_LWIP_ASSERT=y
CONFIG_LWIP_DEBUG=n

# The raw flash HAL serves an owner-controlled module. Loader state sectors
# are inside the running loader partition; SDK partition policy must not abort.
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y

# Preserve calibration/settings when deploying this runtime to either partition.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
