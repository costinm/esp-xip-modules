menu "esp-xip-modules host"

    config XIP_ESPNOW_DIAGNOSTICS
        bool "Detailed ESP-NOW callback diagnostics"
        default n
        help
            Allocate per-epoch callback/error counters while NOW is enabled.
            Normal packet flow counters remain in the link/transport layer.

    config XIP_REQUEST_MAX
        int "Largest request a module can receive"
        default 1024
        help
            Size of the per-module inbox (xip_instance_post / xip_instance_request).

    config XIP_RESPONSE_MAX
        int "Largest answer a module can give with reply()"
        default 1024

    config XIP_WORKER_STACK
        int "Stack of the worker task that runs every module's handlers, bytes"
        default 32768
        help
            Must cover the deepest handler of any installed module (a module image states its need in stack_bytes).
            QUIC receive/handshake and installed flashers can nest sizeable
            decode, stream and native-service frames. The default is 32 KiB.

    config XIP_WORKER_PRIORITY
        int "Priority of the worker task"
        default 5

    config XIP_HANDLER_MS
        int "Handler time budget, ms"
        default 20
        help
            A handler that runs longer is logged and counted (xip_stats_t.overruns).

    config XIP_EVENT_QUEUE
        int "Events queued for the worker (interrupts, alarms, requests)"
        default 32

    config XIP_PKT_SLOTS
        int "Packets in the host's own pool, at most (1704 bytes each, allocated one by one as modules use them)"
        default 64
        range 1 32767

    config XIP_PKT_KEEP
        int "Idle packets that keep their storage (the rest go back to the heap when released)"
        default 4
        range 0 32767

    config XIP_PKT_HEAP_RESERVE
        int "Free heap that must remain after a packet is allocated, bytes"
        default 16384
        help
            A module cannot take the last RAM of the device for packets. The pool is shared by modules, QUIC endpoints and native links.

    config XIP_PKT_QUEUE_INITIAL
        int "Initial capacity of the shared packet delivery queue"
        default 32
        range 1 512
        help
            Only queue descriptors are allocated up front. One global FIFO holds pool references for every module.
            The worker grows descriptors as short bursts require and heap permits. Payload storage remains lazy,
            bounded by XIP_PKT_SLOTS and XIP_PKT_HEAP_RESERVE; receivers drop when storage is unavailable.

    config XIP_PACKET_STATS
        bool "Packet queue high-water and drop counters"
        default y
        help
            Keep counters together in the queue state. Device status reports the queue and pool snapshot.

    config XIP_MEM_QUOTA
        int "Optional per-module allocation limit in bytes (0: use available heap)"
        default 0
        range 0 2147483647
        help
            All modules have access to mem_alloc. Host allocations leave at
            least 32 KiB free at allocation time. A nonzero value also caps
            the total outstanding allocation of each module.

    config XIP_SERIAL_STACK
        int "Stack of the serial reader task (it runs the line handler), bytes"
        default 8192

    config XIP_SPI_MAX_TRANSFER
        int "Largest SPI transfer, bytes"
        default 272
        help
            An SX126x read of a 255-byte packet needs 255 + 4.

    config XIP_QUIC_UDP
        bool "Receive QUIC datagrams on the default UDP port for the application"
        default y
        help
            In active IP mode, deliver UDP datagrams to the common QUIC receive function (xip_quic_rx_set),
            unparsed, as frames of the link "udp". Uses the shared readiness owner; no private task or receive buffer.
            Standalone NAN/NOW operation has no listener. Off: no socket.

    config XIP_QUIC_UDP_PORT
        int "Default UDP port of QUIC packets"
        depends on XIP_QUIC_UDP
        default 3339


endmenu
