menu "esp-xip-modules host"

    config ESPMOD_REQUEST_MAX
        int "Largest request a module can receive"
        default 1024
        help
            Size of the per-module inbox (espmod_instance_post / espmod_instance_request).

    config ESPMOD_RESPONSE_MAX
        int "Largest answer a module can give with respond()"
        default 1024

    config ESPMOD_WORKER_STACK
        int "Stack of the worker task that runs every module's handlers, bytes"
        default 12288
        help
            Must cover the deepest handler of any installed module (a module image states its need in stack_bytes).

    config ESPMOD_WORKER_PRIORITY
        int "Priority of the worker task"
        default 5

    config ESPMOD_HANDLER_MS
        int "Handler time budget, ms"
        default 20
        help
            A handler that runs longer is logged and counted (espmod_stats_t.overruns).

    config ESPMOD_EVENT_QUEUE
        int "Events queued for the worker (interrupts, alarms, requests)"
        default 32

    config ESPMOD_PKT_SLOTS
        int "Packets in the host's own pool, at most (1204 bytes each, allocated one by one as modules use them)"
        default 16

    config ESPMOD_PKT_KEEP
        int "Idle packets that keep their storage (the rest go back to the heap when released)"
        default 2

    config ESPMOD_PKT_HEAP_RESERVE
        int "Free heap that must remain after a packet is allocated, bytes"
        default 16384
        help
            A module cannot take the last RAM of the device for packets. DMesh does not use this pool: it hands the QUIC pool to the host.

    config ESPMOD_PKT_RESERVE
        int "Packets a module cannot take: kept for the application"
        default 2

    config ESPMOD_PKT_HELD
        int "Packets one module can hold at a time (at most 8)"
        default 4
        range 1 8

    config ESPMOD_PKT_INBOX
        int "Packets that can wait for one module"
        default 4

    config ESPMOD_MEM_QUOTA
        int "Bytes one module can take with mem_alloc"
        default 8192

    config ESPMOD_SERIAL_STACK
        int "Stack of the serial reader task (it runs the line handler), bytes"
        default 8192

    config ESPMOD_SPI_MAX_TRANSFER
        int "Largest SPI transfer, bytes"
        default 272
        help
            An SX126x read of a 255-byte packet needs 255 + 4.

endmenu
